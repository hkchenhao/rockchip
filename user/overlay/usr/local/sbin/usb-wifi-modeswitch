#!/usr/bin/python3
"""Bounded USB Wi-Fi installer-mode recovery; NetworkManager manages Wi-Fi."""
import ctypes
import os
from pathlib import Path
import re
import subprocess
import sys
import time

SYSFS = Path('/sys/bus/usb/devices')
DISK = ('0bda', '1a2b')
WIFI = ('0bda', 'c820')
# Limit register recovery to the SYS_CFG1 signature observed on this adapter.
SYS_CFG1 = 0x00491537


def read_state(port):
    if not re.fullmatch(r'\d+-\d+(?:\.\d+)*', port):
        return None
    path = SYSFS / port
    try:
        return (path.joinpath('idVendor').read_text().strip(),
                path.joinpath('idProduct').read_text().strip(),
                int(path.joinpath('busnum').read_text()),
                int(path.joinpath('devnum').read_text()))
    except FileNotFoundError:
        return None


def reset_mcu(usb, sleep=time.sleep):
    if usb.read(0xf0, 4) != SYS_CFG1:
        raise RuntimeError('Unsupported chip signature; refusing MCU recovery')
    # Same volatile reset sequence as rtw88 mac.c:wlan_cpu_enable().
    usb.write(0x03, usb.read(0x03) & ~4)
    usb.write(0x1d, usb.read(0x1d) & ~1)
    sleep(0.02)
    usb.write(0x1d, usb.read(0x1d) | 1)
    usb.write(0x03, usb.read(0x03) | 4)
    sleep(2)


class Control(ctypes.Structure):
    _fields_ = [('request_type', ctypes.c_uint8), ('request', ctypes.c_uint8),
                ('value', ctypes.c_uint16), ('index', ctypes.c_uint16),
                ('length', ctypes.c_uint16), ('timeout', ctypes.c_uint32),
                ('data', ctypes.c_void_p)]


class USBRegisters:
    def __init__(self, port, state):
        self.port, self.state = port, state
        self.fd = os.open(f'/dev/bus/usb/{state[2]:03}/{state[3]:03}', os.O_RDWR)
        self.libc = ctypes.CDLL(None, use_errno=True)
        self.libc.ioctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_void_p]
        self.libc.ioctl.restype = ctypes.c_int

    def close(self):
        os.close(self.fd)

    def transfer(self, request_type, addr, data):
        # Never write to a replacement device or an active WiFi interface.
        if read_state(self.port) != self.state or self.state[:2] != DISK:
            raise RuntimeError('USB identity changed; refusing register access')
        buf = ctypes.create_string_buffer(data, len(data))
        ctrl = Control(request_type, 5, addr, 0, len(data), 1000,
                       ctypes.addressof(buf))
        count = self.libc.ioctl(self.fd, 0xc0185500, ctypes.byref(ctrl))
        if count < 0:
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error))
        if count != len(data):
            raise RuntimeError(f'Short USB register transfer: {count}/{len(data)}')
        return buf.raw

    def read(self, addr, length=1):
        return int.from_bytes(self.transfer(0xc0, addr, bytes(length)), 'little')

    def write(self, addr, value):
        data = bytes([value])
        self.transfer(0x40, addr, data)
        # rtw_usb_reg_sec() synchronizes access to the always-on section.
        self.transfer(0x40, 0x4e0, data)


def eject(state):
    try:
        subprocess.run(['/usr/sbin/usb_modeswitch', '-v', '0x0bda', '-p', '0x1a2b',
                        '-b', str(state[2]), '-g', str(state[3]), '-K'],
                       timeout=10, check=False)
    except subprocess.TimeoutExpired:
        print('Standard eject timed out', flush=True)


def recover(port, state):
    usb = USBRegisters(port, state)
    try:
        reset_mcu(usb)
    finally:
        usb.close()


def switch_installer(port, initial, state_reader, do_eject, do_reset, sleep):
    if initial[:2] == WIFI:
        return 0
    if initial[:2] != DISK:
        raise RuntimeError('Not the supported installation-disk device')
    for attempt in range(2):
        current = state_reader(port)
        if current and current[:2] == WIFI:
            return 0
        if current != initial:
            raise RuntimeError('USB identity changed before switching')
        do_eject(initial)
        for _ in range(20):
            current = state_reader(port)
            if current and current[:2] == WIFI:
                print(f'{port}: WiFi mode c820 verified', flush=True)
                return 0
            if current is not None and current != initial:
                raise RuntimeError('Unexpected replacement device; stopping')
            sleep(0.25)
        if attempt == 0:
            if state_reader(port) != initial:
                raise RuntimeError('Device disappeared; refusing MCU recovery')
            print(f'{port}: eject failed; recovering MCU once', flush=True)
            do_reset(initial)
    raise RuntimeError('Installation-disk mode persists after bounded recovery')



def main():
    if len(sys.argv) != 2:
        raise RuntimeError('Expected usb_modeswitch dispatcher instance')
    port = sys.argv[1]
    initial = read_state(port)
    if not initial or initial[:2] not in (DISK, WIFI):
        os.execv('/usr/sbin/usb_modeswitch_dispatcher',
                 ['usb_modeswitch_dispatcher', '--switch-mode', port])
    return switch_installer(port, initial, read_state, eject,
                            lambda state: recover(port, state), time.sleep)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as error:
        print(f'USB Wi-Fi modeswitch: {error}', file=sys.stderr, flush=True)
        sys.exit(1)
