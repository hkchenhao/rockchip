#!/usr/bin/python3
"""Create a USB NCM gadget; systemd-networkd configures its static address."""
import argparse
import os
from pathlib import Path
import re
import subprocess
import sys
import time

CONFIGFS = Path('/sys/kernel/config')
GADGET = CONFIGFS / 'usb_gadget/usb-ncm'
UDC_ROOT = Path('/sys/class/udc')


def select_udc():
    requested = os.environ.get('USB_NCM_UDC', '')
    if requested:
        if not re.fullmatch(r'[A-Za-z0-9_.:-]+', requested):
            raise ValueError('Invalid USB_NCM_UDC')
        return requested if (UDC_ROOT / requested).exists() else None
    controllers = sorted(p.name for p in UDC_ROOT.glob('*') if p.exists())
    if len(controllers) > 1:
        raise RuntimeError('Multiple USB device controllers; set USB_NCM_UDC explicitly')
    return controllers[0] if controllers else None


def wait_for_udc():
    for attempt in range(51):
        controller = select_udc()
        if controller is not None:
            return controller
        if attempt < 50:
            time.sleep(0.1)
    raise RuntimeError('USB device controller unavailable')


def device_serial():
    for path in (Path('/proc/device-tree/serial-number'), Path('/etc/machine-id')):
        try:
            value = path.read_bytes().replace(b'\x00', b'').replace(b'\n', b'')
        except (FileNotFoundError, PermissionError):
            continue
        if value:
            return value.decode('utf-8')
    return 'usb-ncm'


def write_attribute(name, value):
    (GADGET / name).write_text(value, encoding='utf-8')


def start():
    if subprocess.run(['mountpoint', '-q', str(CONFIGFS)]).returncode != 0:
        subprocess.run(['mount', '-t', 'configfs', 'none', str(CONFIGFS)], check=True)
    controller = wait_for_udc()
    GADGET.mkdir(parents=True, exist_ok=True)
    if (GADGET / 'UDC').read_text().strip():
        return
    for name, value in (
        ('idVendor', '0x1d6b'),
        ('idProduct', '0x0104'),
        ('bcdDevice', '0x0100'),
        ('bcdUSB', '0x0200'),
        ('max_speed', 'high-speed'),
    ):
        write_attribute(name, value)
    for name in ('strings/0x409', 'configs/c.1/strings/0x409', 'functions/ncm.usb0'):
        (GADGET / name).mkdir(parents=True, exist_ok=True)
    for name, value in (
        ('strings/0x409/serialnumber', device_serial()),
        ('strings/0x409/manufacturer', 'Linux'),
        ('strings/0x409/product', 'USB NCM'),
        ('configs/c.1/strings/0x409/configuration', 'NCM'),
        ('configs/c.1/MaxPower', '250'),
        ('functions/ncm.usb0/dev_addr', '02:33:99:00:00:01'),
        ('functions/ncm.usb0/host_addr', '02:33:99:00:00:02'),
    ):
        write_attribute(name, value)
    link = GADGET / 'configs/c.1/ncm.usb0'
    if not link.is_symlink():
        link.symlink_to(GADGET / 'functions/ncm.usb0')
    # Bind last, after the complete configuration is ready for enumeration.
    write_attribute('UDC', controller)


def stop():
    if (GADGET / 'UDC').exists():
        write_attribute('UDC', '\n')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', choices=('start', 'stop'), default='start')
    args = parser.parse_args()
    if args.action == 'start':
        start()
    else:
        stop()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print('USB NCM: {}'.format(error), file=sys.stderr, flush=True)
        sys.exit(1)
